---
import ThemeControl from './ThemeControl.astro';
import { profile } from '../i18n/profile';
import { pageI18n } from '../i18n/helpers';
import { localeUrl, locales, languageTags } from '../i18n/routes';
const { locale, route, t } = pageI18n(Astro.url);
const links = ['research', 'projects', 'experience', 'articles', 'about'] as const;
const labelsForLinks = { ...t.nav, research: profile[locale].research, projects: profile[locale].projects };
const labels = { zh: '中', en: 'EN', ja: '日' };
const languageNames = { zh: '中文', en: 'English', ja: '日本語' };
---
<header class="header">
  <div class="container nav">
    <a class="brand" href={localeUrl(locale)}>nagi.tw</a>
    <button class="menu" aria-expanded="false" aria-controls="nav-links">{t.nav.menu}</button>
    <div class="nav-cluster">
      <nav id="nav-links" aria-label={t.nav.label}>
        <a href={localeUrl(locale)} aria-current={route === '/' ? 'page' : undefined}>{profile[locale].home}</a>
        {links.map((key) => <a href={localeUrl(locale, `/${key}/`)} aria-current={route.startsWith(`/${key}/`) ? 'page' : undefined}>{labelsForLinks[key]}</a>)}
      </nav>
      <div class="language-switcher" data-language-switcher role="group" aria-label={t.nav.language}>
        {locales.map((language) => <button type="button" lang={languageTags[language]} data-language-select={language} data-locale-url={localeUrl(language, route)} aria-label={languageNames[language]} title={languageNames[language]} aria-pressed={language === locale}>{labels[language]}</button>)}
      </div>
      <ThemeControl />
    </div>
  </div>
</header>
<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu');
  const navigation = document.querySelector<HTMLElement>('#nav-links');
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    navigation?.toggleAttribute('data-open', !open);
  });
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-language-select]')) {
    button.addEventListener('click', () => {
      const target = new URL(button.dataset.localeUrl!, location.origin);
      target.search = location.search;
      target.hash = location.hash;
      location.assign(target.href);
    });
  }
</script>
<style>
  .header { position: sticky; top: 0; z-index: 10; border-top: 3px solid var(--accent); border-bottom: 1px solid var(--line); background: var(--paper); }
  .nav { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink); font-family: var(--serif); font-size: 1.2rem; text-decoration: none; }
  .brand { flex-shrink: 0; }
  .brand img { flex: none; image-rendering: pixelated; }
  .brand span { color: var(--muted-readable); font-family: var(--sans); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .nav-cluster, nav, .language-switcher { display: flex; align-items: center; }
  .nav-cluster { gap: clamp(.5rem, 1.5vw, 1.2rem); }
  nav { gap: clamp(0.9rem, 2vw, 1.55rem); }
  nav a { color: var(--muted-readable); font-size: 0.78rem; font-weight: 650; letter-spacing: 0.045em; text-decoration: none; text-transform: uppercase; }
  nav a[aria-current="page"], nav a:hover { color: var(--ink); }
  .language-switcher { gap: 0.15rem; padding-left: 1rem; border-left: 1px solid var(--line); }
  .language-switcher button { min-width: 2.1rem; padding: 0.3rem 0.4rem; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--muted-readable); font: 700 0.72rem/1 var(--sans); cursor: pointer; }
  .language-switcher button[aria-pressed="true"] { border-bottom-color: var(--accent); color: var(--ink); }
  .menu { display: none; padding: 0.35rem 0.6rem; border: 1px solid var(--line); background: none; }
  @media (max-width: 1150px) {
    .nav { gap: .75rem; }
    .menu { display: block; }
    .nav-cluster { margin-left: auto; }
    nav { display: none; position: absolute; top: 100%; right: 16px; left: 16px; max-height: calc(100dvh - 80px); overflow-y: auto; padding: 1rem; border: 1px solid var(--line); background: var(--paper); flex-direction: column; align-items: stretch; }
    nav[data-open] { display: flex; }
  }
  @media (max-width: 600px) {
    .nav { flex-wrap: wrap; padding-block: .6rem; }
    .menu { margin-left: auto; }
    .nav-cluster { flex-basis: 100%; justify-content: flex-end; }
    .language-switcher { padding-left: 0; border-left: 0; }
  }
</style>
