---
import { selectArticleLanguage, type ArticleGroup } from '../lib/articles';
import { categoryOrder } from '../lib/categories';
import { pageI18n, formatDate } from '../i18n/helpers';
import { articleUrl, languageTags } from '../i18n/routes';
interface Props { groups: ArticleGroup[]; filterable?: boolean }
const { groups, filterable = false } = Astro.props;
const { locale, t } = pageI18n(Astro.url);
---
{filterable && (
  <nav class="category-navigation" aria-label={t.common.categories}>
    <div class="category-options" role="group" aria-label={t.common.selectCategory}>
      <button type="button" data-category-filter="all" aria-pressed="true" aria-controls="article-list"><span>{t.common.all}</span></button>
      {categoryOrder.map((category) => <button type="button" data-category-filter={category} aria-pressed="false" aria-controls="article-list"><span>{t.categories[category].title}</span></button>)}
    </div>
  </nav>
)}
<div class="article-index" id="article-list">
  {groups.map((group) => {
    const article = selectArticleLanguage(group, locale);
    return <div class="article-group" data-article-group data-category={group.category} data-group-key={group.key}>
      <article class="article-row" data-article data-language-variant={article.language}>
        <div class="article-meta">
          <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date, locale)}</time>
          <span aria-hidden="true">·</span><span>{t.categories[article.category].title}</span>
          <span aria-hidden="true">·</span><span data-actual-language>{t.common.languages[article.language]}</span>
        </div>
        <h2 lang={languageTags[article.language]}><a href={articleUrl(locale, group.primary.routeSlug)}>{article.data.title}</a></h2>
        {article.data.description && <p lang={languageTags[article.language]}>{article.data.description}</p>}
      </article>
    </div>;
  })}
</div>
<p id="empty" class="empty" role="status" hidden={groups.length > 0}>{t.common.empty}</p>

{filterable && (
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
    let category = 'all';
    const items = [...document.querySelectorAll<HTMLElement>('[data-article-group]')];
    const empty = document.querySelector<HTMLElement>('#empty');

    function filter() {
      let shown = 0;
      for (const item of items) {
        const matches = category === 'all' || item.dataset.category === category;
        item.hidden = !matches;
        if (matches) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    }

    function selectCategory(value: string) {
      category = buttons.some((button) => button.dataset.categoryFilter === value) ? value : 'all';
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.categoryFilter === category));
      filter();
    }
    for (const button of buttons) button.addEventListener('click', () => {
      selectCategory(button.dataset.categoryFilter!);
      const url = new URL(location.href);
      if (category === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', category);
      history.replaceState(null, '', url);
    });
    selectCategory(new URLSearchParams(location.search).get('category') ?? 'all');
    window.addEventListener('popstate', () => selectCategory(new URLSearchParams(location.search).get('category') ?? 'all'));
  </script>
)}

<style>
  .category-navigation { padding-bottom: 1.5rem; }

  .category-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(1.25rem, 3vw, 2.5rem);
  }

  .category-options button {
    padding: 0.85rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: var(--muted-readable);
    font: 500 0.85rem var(--sans);
    white-space: nowrap;
    cursor: pointer;
  }

  .category-english { font-size: 0.72rem; letter-spacing: 0.06em; }
  .category-options button:hover { color: var(--ink); }
  .category-options button[aria-pressed="true"] { border-color: var(--accent); color: var(--ink); }
  .category-options button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .article-index { border-top: 1px solid var(--line); }

  .article-row {
    position: relative;
    padding: clamp(1.25rem, 3vw, 2rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .article-row::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    content: "";
    transition: width 160ms ease;
  }
  .article-row:hover::before { width: clamp(2.5rem, 8vw, 6rem); }

  .article-row[hidden] { display: none; }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.65rem;
    color: var(--muted-readable);
    font-size: 0.74rem;
    letter-spacing: 0.035em;
    text-transform: capitalize;
  }

  h2 {
    max-width: 56rem;
    margin: 0;
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    line-height: 1.16;
    font-weight: 500;
    letter-spacing: -0.02em;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--accent); text-decoration: underline; }

  .article-row > p {
    max-width: 47rem;
    margin: 0.75rem 0 0;
    color: var(--muted-readable);
    font-size: 0.94rem;
  }

  .empty { padding: 2rem 0; color: var(--muted-readable); }

  @media (max-width: 390px) {
    .article-row { padding: 1.75rem 0; }
  }
</style>
