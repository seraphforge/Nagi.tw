---
import { withBase } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { getPublicArticleGroups } from '../lib/articles';
import { categoryInfo, categoryOrder } from '../lib/categories';

const groups = await getPublicArticleGroups();
const recent = groups.slice(0, 3);
---

<BaseLayout>
  <header class="container page-intro notes-intro">
    <p class="eyebrow">The longer record</p>
    <h1>Nagi Notes</h1>
    <p>Notes, experiments,<br />and things worth keeping.</p>
  </header>

  <div class="container notes-home">
    <section class="latest-notes" aria-labelledby="latest-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 · Writing</p>
          <h2 id="latest-title">Latest Notes</h2>
        </div>
        <a class="button-link" href={withBase('/articles/')}>View all articles →</a>
      </div>
      <ArticleList groups={recent} />
      <nav class="notes-links" aria-label="More writing">
        <a href={withBase('/articles/')}>View all articles →</a>
        <a href={withBase('/archive/')}>Archive →</a>
      </nav>
    </section>

    <aside class="notes-topics" aria-labelledby="topics-title">
      <p class="eyebrow">02 · Sections</p>
      <h2 id="topics-title">Follow a thread.</h2>
      <nav aria-label="Article categories">
        {categoryOrder.map((category) => (
          <a href={withBase(`/articles/?category=${category}`)} title={categoryInfo[category].description}>
            <span>{categoryInfo[category].title}<small>{categoryInfo[category].zh}</small></span>
            <span class="topic-count">{groups.filter((group) => group.category === category).length}</span>
          </a>
        ))}
      </nav>
      <p><a class="personal-link" href={withBase('/topics/')}>Browse detailed topics →</a></p>
      <p class="notes-origin">By Nagi.</p>
      <a class="personal-link" href="https://notes.nagi.tw/">Nagi.tw ↗</a>
    </aside>
  </div>
</BaseLayout>

<style>
  .notes-intro { padding-top: 4.5rem; padding-bottom: 3.5rem; }
  .notes-home {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    padding-bottom: var(--space-section);
  }
  .latest-notes { grid-column: 1 / 9; min-width: 0; }
  .latest-notes .section-head { align-items: end; gap: 1rem; }
  .latest-notes h2 { font-size: 2rem; }
  .notes-topics { grid-column: 10 / 13; min-width: 0; border-top: 6px solid var(--signal-lime); padding-top: 1.5rem; }
  .notes-topics h2 { margin: 0.65rem 0 1.5rem; font-size: 2rem; }
  .notes-topics nav { border-top: 1px solid var(--line); }
  .notes-topics nav a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .notes-topics nav a:hover { color: var(--accent); }
  .topic-count { color: var(--muted-readable); font-family: var(--mono); font-size: 0.8rem; }
  .notes-topics small { display: block; color: var(--muted-readable); font-size: 0.75rem; }
  .notes-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding-top: 1.75rem; }
  .notes-links a, .personal-link { color: var(--ink); }
  .notes-origin { margin: 2.5rem 0 0.35rem; color: var(--muted-readable); }
  @media (max-width: 760px) {
    .notes-intro { padding-top: 3rem; padding-bottom: 3rem; }
    .latest-notes, .notes-topics { grid-column: 1 / -1; }
    .notes-topics { margin-top: 2rem; }
  }
  @media (max-width: 360px) {
    :global(body:has(.notes-home) .header .nav) { gap: 0.5rem; }
    :global(body:has(.notes-home) .header .language-switcher) { padding-left: 0.5rem; }
  }
</style>
