---
import { withBase } from '../lib/urls';
import { pageI18n } from '../i18n/helpers';
import { locales, localeUrl, languageTags } from '../i18n/routes';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; articleLanguage?: string }
const { locale, route, t } = pageI18n(Astro.url);
const { title = 'Nagi.tw', description = t.articles.description, image, articleLanguage } = Astro.props;
const fullTitle = title === 'Nagi.tw' ? title : `${title} — Nagi.tw`;
const canonical = new URL(localeUrl(locale, route), Astro.site);
---
<!doctype html><html lang={languageTags[locale]} data-locale={locale} data-article-page={articleLanguage ? '' : undefined} data-current-article-language={articleLanguage}><head><meta charset="UTF-8"/><link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')}/><meta name="viewport" content="width=device-width"/><title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{locales.map((language) => <link rel="alternate" hreflang={languageTags[language]} href={new URL(localeUrl(language, route), Astro.site)}/>)}<link rel="alternate" hreflang="x-default" href={new URL(localeUrl('zh', route), Astro.site)}/><meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/>{image && <meta name="twitter:image" content={new URL(withBase(image), Astro.site)}/>}<meta property="og:site_name" content="Nagi.tw"/><script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": [{ "@type": "Person", "@id": new URL('/#person', Astro.site).href, name: "Hong Xin-Fu", alternateName: "Nagi", url: Astro.site?.href }, { "@type": "WebSite", "@id": new URL('/#website', Astro.site).href, name: "Nagi.tw", url: Astro.site?.href, inLanguage: Object.values(languageTags), author: { "@id": new URL('/#person', Astro.site).href } }] }).replaceAll('<', '\\u003c')} /><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={articleLanguage ? 'article' : 'website'}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={{ zh: 'zh_TW', en: 'en_US', ja: 'ja_JP' }[locale]}/>{image&&<meta property="og:image" content={new URL(withBase(image),Astro.site)}/>}<link rel="alternate" type="application/rss+xml" title="Nagi.tw" href={withBase('/rss.xml')}/><script is:inline>
try { document.documentElement.dataset.theme = localStorage.getItem('nagi-theme') === 'dark' ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = 'light'; }
</script></head><body><a class="skip" href="#main">{t.common.skip}</a><SiteHeader/><main id="main"><slot/></main><SiteFooter/></body></html>
