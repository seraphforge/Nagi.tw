---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicArticleGroups, selectArticleLanguage } from '../lib/articles';
import { pageI18n } from '../i18n/helpers';
import { articleUrl, languageTags } from '../i18n/routes';
const { locale, t } = pageI18n(Astro.url);
const groups = await getPublicArticleGroups();
const years = [...new Set(groups.map((group) => group.primary.data.date.getUTCFullYear()))];
const monthName = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-TW' : locale, { month: 'long', timeZone: 'UTC' });
---
<BaseLayout title={t.archive.title} description={t.archive.description}>
  <header class="container intro"><p class="eyebrow">{t.archive.eyebrow}</p><h1>{t.archive.title}</h1></header>
  <div class="container archive">
    {years.map((year) => <section class="archive-year"><h2>{year}</h2>
      {[...new Set(groups.filter((group) => group.primary.data.date.getUTCFullYear() === year).map((group) => group.primary.data.date.getUTCMonth()))].map((month) => <section class="archive-month">
        <h3>{monthName.format(new Date(Date.UTC(year, month, 1)))}</h3>
        <div class="archive-entries">{groups.filter((group) => group.primary.data.date.getUTCFullYear() === year && group.primary.data.date.getUTCMonth() === month).map((group) => {
          const article = selectArticleLanguage(group, locale);
          return <article class="archive-row" data-group-key={group.key}>
            <time datetime={group.primary.data.date.toISOString().slice(0, 10)}>{group.primary.data.date.getUTCDate().toString().padStart(2, '0')}</time>
            <div class="archive-entry" data-language-variant={article.language}>
              <a href={articleUrl(locale, group.primary.routeSlug)} lang={languageTags[article.language]}>{article.data.title}</a>
              <p>{t.categories[article.category].title} <span aria-hidden="true">·</span> <span data-actual-language>{t.common.languages[article.language]}</span></p>
            </div>
          </article>;
        })}</div>
      </section>)}
    </section>)}
  </div>
</BaseLayout>
<style>
  .intro { position: relative; padding: clamp(2rem, 4vw, 3.5rem) 0 2rem; border-top: 3px solid var(--accent); }
  .intro h1 { margin: 0.35rem 0 0; }

  .archive {
    width: min(960px, calc(100% - 40px));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .archive-year {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 1rem;
    border-top: 1px solid var(--line);
  }

  .archive-year > h2 {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    color: var(--ink);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.055em;
  }

  .archive-month {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .archive-month > h3 {
    margin: 0;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted-readable);
    font-family: var(--sans);
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .archive-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: clamp(0.8rem, 2.5vw, 1.5rem);
    align-items: start;
    padding: clamp(1.25rem, 3vw, 1.8rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .archive-row time {
    padding-top: 0.15rem;
    color: var(--muted-readable);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }

  .archive-entry {
    min-width: 0;
  }

  .archive-entry a {
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    line-height: 1.28;
    text-decoration: none;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .archive-entry a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .archive-entry p {
    margin: 0.4rem 0 0;
    color: var(--muted-readable);
    font-size: 0.78rem;
    line-height: 1.5;
    text-transform: capitalize;
  }

  @media (max-width: 720px) {
    .intro {
      padding-top: 2rem;
    }

    .archive {
      width: min(100% - 32px, 960px);
      padding-bottom: 2.5rem;
    }

    .archive-year {
      padding-top: 1.5rem;
    }

    .archive-year > h2 {
      margin-bottom: 1.5rem;
    }

    .archive-month {
      margin-bottom: 2rem;
    }

    .archive-row {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.9rem 0;
    }
  }
</style>
